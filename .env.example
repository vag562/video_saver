BOT_TOKEN=123456:replace_me
# Local Telegram Bot API server inside Docker network. Leave empty to use the standard Telegram Bot API.
BOT_API_BASE_URL=http://telegram-bot-api:8081
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
PUBLIC_BASE_URL=http://localhost
DATABASE_URL=postgresql+asyncpg://video_saver:video_saver@postgres:5432/video_saver
REDIS_URL=redis://redis:6379/0
ADMIN_USER_IDS=[]
DOWNLOADS_DIR=/data/downloads
MAX_TELEGRAM_FILE_MB=1900
DOWNLOAD_LINK_TTL_SECONDS=10800
CLEANUP_INTERVAL_SECONDS=900
MIN_FREE_DISK_MB=1024
RQ_QUEUE_NAME=downloads
POSTGRES_DB=video_saver
POSTGRES_USER=video_saver
POSTGRES_PASSWORD=video_saver
